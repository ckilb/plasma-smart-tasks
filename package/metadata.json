        "EnabledByDefault": true,
        "Icon": "preferences-system-windows",
        "Id": "io.github.ckilb.smarttasks",
        "License": "GPL-2.0-or-later",
        "Name": "Smart Tasks",
        "Name[de]": "Intelligente Aufgabenleiste",
        "Version": "1.0.0",
        "Website": "https://github.com/ckilb/plasma-smart-tasks"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-Provides": [
        "org.kde.plasma.multitasking"
    ]
}
